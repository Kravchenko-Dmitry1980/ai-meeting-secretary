POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_STT_MODEL=openai/whisper-large-v3-turbo
POLZA_SUMMARY_MODEL=
# Prices must be verified for the selected route; unknown prices pause cloud work.
STT_PRICE_RUB_PER_MINUTE=
SUMMARY_INPUT_RUB_PER_MILLION=
SUMMARY_OUTPUT_RUB_PER_MILLION=
CHUNK_SECONDS=120
REQUEST_TIMEOUT_SECONDS=180
MEETING_BUDGET_RUB=100
ALLOW_UNKNOWN_PRICE=false
CLOUD_ENABLED=true
