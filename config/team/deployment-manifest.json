{
  "schema_version": 1,
  "qualification": "OFFLINE_PACKAGE_ONLY",
  "activation": "owner_approval_required",
  "public_listener": {"protocol": "https", "host": "owner_configured", "tcp_port": 443},
  "gateway": {"host": "127.0.0.1", "port": 8766, "proxy_headers": false},
  "caddy": {
    "version": "2.11.7",
    "architecture": "windows_amd64",
    "license": "Apache-2.0",
    "license_url": "https://github.com/caddyserver/caddy/blob/v2.11.7/LICENSE",
    "release_url": "https://github.com/caddyserver/caddy/releases/tag/v2.11.7",
    "artifact_url": "https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_windows_amd64.zip",
    "artifact_size_bytes": 18479498,
    "artifact_sha256": "0a1edc0b799512051c57071ce0e798d3f2cf67dc98171366f1d2b326072e3b06",
    "binary_sha256": "5f93a9bd555f3aac9d33af2756ba14b3519d8cca4ffd55256bdaeab444c9db2a",
    "checksums_url": "https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_checksums.txt",
    "standard_modules_only": true,
    "admin_api": false,
    "persist_config": false,
    "http_access_logging": false,
    "http_error_logging": false,
    "certificate_storage_env": "TEAM_CADDY_DATA",
    "certificate_challenge": "tls-alpn-01",
    "automatic_http_redirect": false,
    "global_trust_changes": false
  },
  "template": "config/team/Caddyfile.example",
  "required_environment": ["TEAM_PUBLIC_HOST", "TEAM_PUBLIC_ROOT", "TEAM_ASSET_ROUTES", "TEAM_CADDY_DATA"],
  "path_policy": "case_sensitive_exact_routes; reject raw percent, backslash, repeated slash and dot segments before routing; query encodings remain permitted",
  "public_routes": [
    {"methods": ["POST"], "path": "/hooks/max", "max_body_bytes": 1048576},
    {"methods": ["GET", "HEAD"], "path": "/team", "redirect": "/team/", "status": 308},
    {"methods": ["GET", "HEAD"], "path": "/team/", "file": "team.html"},
    {"methods": ["GET", "HEAD"], "path_source": "package asset-routes.caddy exact generated case-sensitive allowlist"},
    {"methods": ["POST"], "path": "/api/team/v1/session/max"},
    {"methods": ["POST"], "path": "/api/team/v1/session/code"},
    {"methods": ["DELETE"], "path": "/api/team/v1/session"},
    {"methods": ["GET"], "path": "/api/team/v1/me"},
    {"methods": ["GET"], "path": "/api/team/v1/members"},
    {"methods": ["GET"], "path": "/api/team/v1/status"},
    {"methods": ["GET"], "path": "/api/team/v1/dashboard"},
    {"methods": ["GET"], "path": "/api/team/v1/tasks"},
    {"methods": ["GET"], "path": "/api/team/v1/tasks/{decimal_id}"},
    {"methods": ["GET"], "path": "/api/team/v1/tasks/{decimal_id}/history"},
    {"methods": ["GET"], "path": "/api/team/v1/tasks/{decimal_id}/due-resolution"},
    {"methods": ["POST"], "path": "/api/team/v1/tasks/{decimal_id}/due-resolution/previews"},
    {"methods": ["POST"], "path": "/api/team/v1/due-resolutions/{uuid}/confirm"},
    {"methods": ["POST"], "path": "/api/team/v1/commands"},
    {"methods": ["GET"], "path": "/api/team/v1/commands/{uuid}"}
  ],
  "denied_surfaces": ["all other paths", "internal task publications", "local owner API", "Secretary entry", "Vikunja native UI", "databases", "audio", "source maps", "package metadata"],
  "static_package": {
    "builder": "scripts/team/prepare_public_assets.py",
    "release_parent": ".runtime/team/public/releases",
    "root_env": "TEAM_PUBLIC_ROOT",
    "exact_routes_env": "TEAM_ASSET_ROUTES",
    "private_metadata": ["deploy-manifest.json", "asset-routes.caddy"],
    "whole_frontend_dist_forbidden": true
  },
  "limits": {
    "api_body_bytes": 262144,
    "hook_body_bytes": 1048576,
    "header_bytes": 32000,
    "read_header_seconds": 5,
    "complete_body_seconds": 10,
    "write_seconds": 20,
    "idle_seconds": 30,
    "proxy_dial_seconds": 2,
    "proxy_response_header_seconds": 10,
    "proxy_retries": 0,
    "rate_store": "gateway AuthRepository durable counters; no Caddy plugin",
    "rate_window_seconds": 60,
    "api_global": 1200,
    "api_peer": 240,
    "verified_hook_global": 600,
    "verified_hook_peer": 120,
    "login_global": 120,
    "login_peer": 20
  },
  "proxy_identity": {"header": "X-Team-Client-IP", "set_from": "Caddy actual remote_host", "trusted_by_gateway_only_from_actual_loopback": true, "forwarded_and_xff_ignored": true},
  "unverified_live_gates": ["owner domain and DNS", "WAN/static IP/CGNAT", "NAT/firewall", "external HTTPS443 and certificate chain", "MAX webhook roundtrip", "MAX browser embedding and cookies"]
}
