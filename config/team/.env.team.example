# Historical field reference; all example values are empty.
# Production reads explicit protected runtime JSON, not .env.team.
# Follow docs/TEAM_RUNTIME.md and docs/TEAM_MANUAL_ACCEPTANCE.md for current setup.
# Use an exact HTTPS origin after the domain/WAN/CGNAT/mobile-network check.
TEAM_PUBLIC_ORIGIN=
# Proxy configuration is validated before T12 activation; no automatic publication.
# Host without scheme/port. Root and routes point to one immutable Team release.
TEAM_PUBLIC_HOST=
TEAM_PUBLIC_ROOT=
TEAM_ASSET_ROUTES=
# Project-local certificate storage, outside the public release.
TEAM_CADDY_DATA=
MAX_BOT_ID=
MAX_BOT_TOKEN=
# Public bot name registered for native open_app. This is not the miniapp URL.
MAX_BOT_USERNAME=
# Independently generated local secret for the MAX webhook header.
MAX_WEBHOOK_SECRET=
# Generate locally. Never place in command-line arguments, source, browser or logs.
TEAM_AUTH_SECRET=
TEAM_DATABASE_PATH=
TEAM_LOCAL_OWNER_ID=
TEAM_GATEWAY_PORT=
