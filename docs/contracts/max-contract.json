  "inbound_policy": {
    "authority": "Secretary approved design; these are local policy, not MAX guarantees",
    "source_path": "docs/superpowers/specs/2026-10-03-secretary-vikunja-max-design.md",
    "path": "/hooks/max",
    "max_body_bytes": 1048576,
    "require_configured_secret": true,
    "target_ack_seconds": 1,
    "durable_inbox_before_200": true,
    "db_unavailable_http_status": 503,
    "work_after_ack": [
      "media fetch",
      "Polza ASR/LLM",
      "task mutations",
      "outbound notifications"
    ],
    "actor": "message.sender.user_id or callback.user.user_id must map to an active allowlisted member; never infer actor from recipient, forwarded sender, display name or voice.",
    "unknown_member_can_start_paid_work": false,
    "canonical_ids": "Backend exact int64; local UI DTO IDs are decimal strings.",
    "deduplication": {
      "scope": "Include configured bot identity.",
      "message_created": "type + body.mid; forwarded-only/no-mid falls back to canonical composite hash.",
      "message_callback": "type + callback.callback_id",
      "message_edited": "type + mid + timestamp/seq/content identity; do not collide with creation.",
      "other_events": "Canonical payload hash including type, timestamp and applicable actor/chat IDs when no stable event ID exists.",
      "same_stable_id_different_payload": "Conflict/quarantine; never silently apply both.",
      "unknown_events": "Persist/quarantine without side effects; no paid dispatch."
    },
    "sends": "HTTP acceptance is not human reading. Mark ambiguous transport outcomes uncertain; never blindly resend. Bounded backoff only for definitely-not-accepted outcomes (including documented rate limits)."
  },
  "init_data": {
    "source_ids": [
      "initdata_validation",
      "bridge",
      "miniapp"
    ],
    "input": "window.WebApp.initData encoded UTF-8 string; raw WebAppData URL-fragment value is an alternative with one additional outer decoding layer.",
    "unsafe_object_can_authenticate": false,
    "outer_platform_keys_unique": true,
    "signed_keys_unique": true,
    "required_for_signature": [
      "hash"
    ],
    "documented_bridge_shape_required": [
      "query_id",
      "auth_date",
      "hash",
      "user",
      "chat",
      "start_param"
    ],
    "optional_bridge_fields": [
      "ip"
    ],
    "local_authentication_required": [
      "hash",
      "auth_date",
      "user.id"
    ],
    "unknown_signed_fields": "Preserve and include every field except hash; do not discard extras before calculating the signature.",
    "decode": "Decode percent-encoding exactly once at each explicit layer. Preserve decoded raw values and JSON spelling. Follow decodeURIComponent semantics for inner values: a literal + remains +; never apply an additional unquote/JSON reserialization.",
    "canonical_data": "Sort keys lexicographically, omit hash, join key=value with LF (0x0A), UTF-8.",
    "secret_key": "HMAC-SHA256(key=UTF8('WebAppData'), message=UTF8(bot_token))",
    "signature": "lowercase hex HMAC-SHA256(key=secret_key bytes, message=UTF8(canonical_data))",
    "hash_comparison": "constant time (local hardening)",
    "auth_date_unit": "Unix seconds",
    "miniapp_user_id_field": "user.id",
    "bot_api_user_id_field": "user.user_id",
    "documented_miniapp_user_shape": {
      "id": "number",
      "first_name": "string",
      "last_name": "string; official validation example allows null",
      "username": "string; official validation example allows null",
      "language_code": "string",
      "photo_url": "string; official validation example allows null"
    },
    "miniapp_chat_type_enum": [
      "DIALOG",
      "CHAT",
      "CHANNEL"
    ],
    "bridge_recommended_max_age_seconds": 3600,
    "local_policy": {
      "max_age_seconds": 300,
      "future_clock_skew_seconds": 30,
      "replay_key": "bot_id + verified user_id + auth_date + verified signature bytes (not raw query string hash)",
      "reopen_after_expiry": true,
      "server_only_token": true
    },
    "startapp_payload": {
      "max_length": 512,
      "allowed_characters": "A-Z a-z 0-9 _ -",
      "url_template": "https://max.ru/<botName>?startapp=<payload>",
      "source_ids": [
        "miniapp"
      ]
    }
  },
  "audio": {
    "source_ids": [
      "sdk_attachment"
    ],
    "documented_attachment_type": "audio",
    "required_fields": [
      "type",
      "payload.url",
      "payload.token"
    ],
    "provider_embedded_transcript_field": null,
    "provider_duration_field_in_audio_attachment": null,
    "native_voice_status": "NOT_QUALIFIED",
    "native_voice_guaranteed_in_every_client": false,
    "known_unknowns": [
      "Whether native voice reaches the bot as non-empty audio on each actual Android/iOS client",
      "Current signed media CDN hosts, URL expiry and redirect chain",
      "Actual duration and audio codec of each received file",
      "Whether unavailable native voice needs audio-file or mini-app recording fallback"
    ],
    "issue_reference": {
      "url": "https://github.com/max-messenger/max-bot-api-client-ts/issues/250",
      "authority": "User report, not a current universal failure guarantee"
    },
    "local_limits": {
      "authority": "Secretary approved design, not MAX provider limits",
      "max_duration_seconds": 120,
      "max_download_bytes": 10485760,
      "duration_check": "FFprobe on actual downloaded bytes",
      "decode": "CPU FFmpeg with deadline; no GPU ASR",
      "download_policy": "Verified event only; HTTPS and observed CDN allowlist, public-address DNS and redirect checks; no signed URLs/tokens in logs."
    },
    "acceptance_gate": "Real file-audio and real native-voice tests are separate; SDK audio type and offline fixture success do not prove native voice."
  },
  "prerequisites": {
    "source_ids": [
      "bot_create",
      "miniapp",
      "events"
    ],
    "eligibility": "RF-resident legal entity, individual entrepreneur (IP), or self-employed account.",
    "profile_verification_required": true,
    "moderation_required": true,
    "token_obtained_by": "Verified owner via business.max.ru or MAX for Business; no token included in this artifact.",
    "bot_creation_slots": {
      "organization_or_ip": 5,
      "self_employed": 2
    },
    "bot_visibility": "Moderated bot is discoverable by MAX users; private task access is enforced by local allowlist, not display name.",
    "miniapp_requires_bot": true,
    "miniapp_requires_own_https_hosting": true,
    "paid_subscription_required_by_reviewed_setup_instructions": false,
    "permanent_free_api_price_guaranteed": false,
    "pricing_note": "Reviewed official creation/setup pages do not specify a per-call fee or require a paid subscription. They do not guarantee permanently free API or free domain/static IP/hosting.",
    "current_owner_readiness": "Owner reports IP exists. Verified business profile, moderation, token and stable public HTTPS route remain unverified."
  },
  "discrepancies": [
    {
      "id": "message_body_null",
      "sources": [
        "message",
        "sdk_message"
      ],
      "difference": "Docs allow Message.body=null for forwarded-only messages; SDK declares MessageBody.",
      "resolution": "Accept null inbound body; no text/audio command without a body."
    },
    {
      "id": "user_nullability_and_activity",
      "sources": [
        "user",
        "sdk_user"
      ],
      "difference": "Docs allow last_name/name null and last_activity_time omission when online is hidden; SDK uses last_name?:string, name:string, last_activity_time:number.",
      "resolution": "Inbound schema follows documented nullable last_name and optional activity; deprecated name is optional local compatibility policy."
    },
    {
      "id": "webhook_only_admin_event",
      "sources": [
        "updates",
        "sdk_updates"
      ],
      "difference": "Docs list bot_admin_permissions_changed (Webhook only); SDK Update union does not.",
      "resolution": "Retain as untyped/quarantined event until payload fields are verified; no guessed payload schema."
    },
    {
      "id": "polling_marker",
      "sources": [
        "polling",
        "sdk_subscription"
      ],
      "difference": "Docs allow nullable marker; SDK declares number.",
      "resolution": "Use nullable cursor in test tooling; never use as webhook event ID."
    },
    {
      "id": "miniapp_nullable_example",
      "sources": [
        "bridge",
        "initdata_validation"
      ],
      "difference": "Bridge interface shows strings but official validation example has null username/photo_url.",
      "resolution": "Do not require optional display/profile fields for identity; sign their raw spelling."
    },
    {
      "id": "secret_pattern",
      "sources": [
        "subscribe"
      ],
      "difference": "Published regex includes underscore while prose list omits it.",
      "resolution": "Pinned regex is ^[a-zA-Z0-9_-]{5,256}$; use a safe alphanumeric secret for live setup."
    }
  ],
