      "secret_optional_at_provider": true,
      "success_http_status": 200,
      "response_deadline_seconds": 30,
      "retries": {
        "additional_attempts_up_to": 10,
        "first_delay_seconds": 60,
        "multiplier": 2.5,
        "documented_first_delays_seconds": [
          60,
          150,
          375
        ],
        "auto_unsubscribe_after_unsuccessful_hours": 8
      }
    },
    "subscription": {
      "method": "POST",
      "path": "/subscriptions",
      "request_schema": "#/$defs/SubscribeRequest",
      "response_schema": "#/$defs/ActionResponse",
      "documented_statuses": [
        200,
        401,
        500
      ],
      "successful_result_requires": "HTTP 200 and body.success == true"
    },
    "polling": {
      "method": "GET",
      "path": "/updates",
      "production_supported": false,
      "mutually_exclusive_with_webhook": true,
      "query": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "required": false
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90,
          "default": 30,
          "required": false
        },
        "marker": {
          "type": "int64|null",
          "required": false
        },
        "types": {
          "wire_encoding": "Comma-separated event types",
          "required": false
        }
      },
      "response": {
        "required": [
          "updates",
          "marker"
        ],
        "updates": "Update[]",
        "marker": "int64|null"
      },
      "cursor_semantics": "marker is a paging cursor, never a webhook event ID. Advancing marker marks preceding updates read; omission/null returns latest only."
    },
    "callback_answer": {
      "method": "POST",
      "path": "/answers",
      "query_required": {
        "callback_id": "nonblank string"
      },
      "query_optional": {
